# .env.example — commit this; real values live in .env.local / the hosting secret store (A-7).
# Supabase project provided by the Director (AMB resolutions, 2026-09-27).
NEXT_PUBLIC_SUPABASE_URL=https://dezevstfmfliyasdeflj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Server only — never NEXT_PUBLIC_ (A-8). Used for account administration after authorisation.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server only (PDL-023): Gemini key for search by meaning (embeddings). Only catalogue text and search text are sent.
# GOOGLE_API_KEY is accepted as an alternative name. Without a key, search works by words.
GEMINI_API_KEY=your_gemini_api_key_here
